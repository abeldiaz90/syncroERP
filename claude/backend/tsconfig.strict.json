{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "incremental": false
  },
  "exclude": ["node_modules", "dist", "test", "**/*.spec.ts"]
}
