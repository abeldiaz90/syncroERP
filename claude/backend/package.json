{
  "name": "syncro-erp-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11 <23"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:bootstrap": "ts-node -r tsconfig-paths/register src/database/commands/bootstrap-database.ts",
    "db:verify": "ts-node -r tsconfig-paths/register src/database/commands/verify-database.ts",
    "test:integracion": "ts-node -r tsconfig-paths/register scripts/e2e-integracion.ts",
    "cuentas:aprovisionar": "ts-node -r tsconfig-paths/register scripts/aprovisionar-cuentas.ts",
    "flujo:simular": "ts-node -r tsconfig-paths/register scripts/simular-flujo-validacion.ts",
    "fineract:probar": "ts-node -r tsconfig-paths/register scripts/probar-fineract.ts",
    "credito:autorizar": "ts-node -r tsconfig-paths/register scripts/autorizar-linea-credito.ts",
    "credito:matriz": "ts-node -r tsconfig-paths/register scripts/configurar-matriz-credito.ts",
    "usuario:alta": "ts-node -r tsconfig-paths/register scripts/alta-usuario-erp.ts",
    "cobranza:diagnosticar": "ts-node -r tsconfig-paths/register scripts/diagnosticar-cobranza.ts",
    "outbox:reintentar": "ts-node -r tsconfig-paths/register scripts/reintentar-outbox.ts",
    "venta:verificar": "ts-node -r tsconfig-paths/register scripts/verificar-venta-credito.ts",
    "db:reset:operaciones": "ts-node -r tsconfig-paths/register src/database/commands/reset-empresa-operaciones.ts",
    "db:schema:verify": "ts-node -r tsconfig-paths/register src/database/commands/verify-schema.ts",
    "audit:security": "python3 ../tools/auditar-seguridad-backend.py",
    "audit:update-dtos": "node tools/audit-update-dtos.js",
    "build:strict": "tsc -p tsconfig.strict.json",
    "schema:build": "npm run db:bootstrap",
    "db:migration:show": "typeorm-ts-node-commonjs migration:show -d src/database/data-source.ts",
    "db:migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "db:migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "db:rebuild:dev": "ts-node -r tsconfig-paths/register src/database/commands/rebuild-development.ts",
    "db:migrate:mssql-to-postgres": "node tools/migrate-mssql-to-postgres.cjs --execute",
    "productos:catalogo": "ts-node -r tsconfig-paths/register scripts/catalogo-productos.ts",
    "creditos:auditar-fechas": "ts-node -r tsconfig-paths/register scripts/auditar-fechas-credito.ts",
    "productos:probar": "ts-node -r tsconfig-paths/register scripts/probar-catalogo-credito.ts",
    "credito:probar-escenarios": "ts-node -r tsconfig-paths/register scripts/probar-escenarios-credito.ts",
    "outbox:estado": "ts-node -r tsconfig-paths/register scripts/estado-outbox.ts",
    "credito:probar-reversas": "ts-node -r tsconfig-paths/register scripts/probar-reversas-credito.ts",
    "db:probar-consultas": "ts-node -r tsconfig-paths/register scripts/probar-consultas-heredadas.ts",
    "credito:probar-mora": "ts-node -r tsconfig-paths/register scripts/probar-mora-credito.ts",
    "fineract:inspeccionar": "ts-node -r tsconfig-paths/register scripts/inspeccionar-api-fineract.ts",
    "fineract:cob": "ts-node -r tsconfig-paths/register scripts/diagnosticar-cob-fineract.ts",
    "fineract:habilitar-cob": "ts-node -r tsconfig-paths/register scripts/habilitar-cob-fineract.ts",
    "fineract:morosidad": "ts-node -r tsconfig-paths/register scripts/diagnosticar-morosidad-fineract.ts",
    "fineract:bucket-mora": "ts-node -r tsconfig-paths/register scripts/atar-bucket-mora-fineract.ts",
    "fineract:hoja-cobranza": "ts-node -r tsconfig-paths/register scripts/probar-hoja-cobranza-fineract.ts",
    "fineract:avisos": "ts-node -r tsconfig-paths/register scripts/registrar-avisos-fineract.ts",
    "avisos:buzon": "ts-node -r tsconfig-paths/register scripts/ver-buzon-avisos.ts",
    "conciliacion:correr": "ts-node -r tsconfig-paths/register scripts/conciliar-cartera.ts",
    "empresa:prueba": "ts-node -r tsconfig-paths/register scripts/empresa-prueba-autoridad.ts",
    "autoridad:probar": "ts-node -r tsconfig-paths/register scripts/probar-autoridad.ts",
    "aislamiento:administradores": "ts-node -r tsconfig-paths/register scripts/verificar-aislamiento-administradores.ts",
    "fineract:limpiar-inquilinos": "ts-node -r tsconfig-paths/register scripts/limpiar-inquilinos-fineract.ts",
    "cp:importar": "ts-node -r tsconfig-paths/register scripts/importar-codigos-postales.ts",
    "compras:e2e": "ts-node -r tsconfig-paths/register scripts/e2e-compras.ts",
    "compras:verificar": "ts-node -r tsconfig-paths/register scripts/verificar-compras.ts",
    "cp:estatus": "ts-node -r tsconfig-paths/register scripts/estado-codigos-postales.ts",
    "cliente:duplicado": "ts-node -r tsconfig-paths/register scripts/diagnosticar-duplicado-cliente.ts",
    "clientes:auditar-nombres": "ts-node -r tsconfig-paths/register scripts/auditar-nombres-clientes.ts",
    "fineract:contabilidad": "ts-node -r tsconfig-paths/register scripts/aprovisionar-contabilidad-fineract.ts",
    "clientes:expediente": "ts-node -r tsconfig-paths/register scripts/sincronizar-expedientes-clientes.ts"
  },
  "dependencies": {
    "@nestjs-modules/mailer": "^2.3.7",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.24",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.1",
    "axios": "^1.18.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "country-state-city": "^3.2.1",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "helmet": "^8.3.0",
    "jwks-rsa": "^4.1.0",
    "mssql": "^12.5.5",
    "multer": "^2.2.0",
    "nodemailer": "9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "puppeteer": "^25.3.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cron": "^2.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "overrides": {
    "linkify-it": "5.0.2",
    "uuid": "11.1.1",
    "nodemailer": "9.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "/node_modules/(?!jose)"
    ]
  }
}
